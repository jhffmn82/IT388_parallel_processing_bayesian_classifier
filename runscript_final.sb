./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 2

./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 4
