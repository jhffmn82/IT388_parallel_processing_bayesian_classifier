#!/bin/bash
#SBATCH --job-name="project_output"
#SBATCH --output="project_output.%j.%N.out"
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --exclusive
#SBATCH --ntasks-per-node=128
#SBATCH --mem=0
#SBATCH --account=isu103
#SBATCH --export=ALL
#SBATCH -t 02:00:00

# ==============================================================
# MODULE SETUP - start from clean slate, load exactly what we need
# ==============================================================

module load cpu/0.17.3b
module load gcc/10.2.0
module load openmpi/4.1.3


echo "=== Modules loaded ==="
module list 2>&1
echo ""

# ==============================================================
# COMPILE - build all four binaries fresh
# ==============================================================
echo "=== Compiling binaries ==="
gcc -O2 -Wall -fopenmp nb_classifier.c -lm -o serial_executable
gcc -O2 -Wall -fopenmp omp_nb_classifier.c -lm -o omp_executable
srun -O2 -Wall -Wno-unused-result mpi_nb_classifier.c -lm -o mpi_executable
mpicc -O2 -Wall -fopenmp -Wno-unused-result nb_classifier_hybrid.c -lm -o hybrid_executable

# Verify all four binaries built successfully before proceeding
if [ ! -x serial_executable ] || [ ! -x omp_executable ] || [ ! -x mpi_executable ] || [ ! -x hybrid_executable ]; then
    echo "ERROR: One or more binaries failed to compile. Aborting."
    ls -la *executable 2>/dev/null
    exit 1
fi
echo "=== All four binaries compiled successfully ==="
ls -la *executable
echo ""

# ==============================================================
# PHASE 1 - Heart correctness check (1 run each)
# ==============================================================
echo "=== PHASE 1: Heart correctness check ==="
./serial_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_serial.csv 5 1
./omp_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_omp.csv 5 8
mpiexec -n 8 ./mpi_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_mpi.csv 5 8
mpiexec --oversubscribe -n 4 ./hybrid_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_hybrid.csv 5 8

# ==============================================================
# PHASE 2 - Data-size scaling (1 run each at 20k, 100k, 500k)
# ==============================================================
echo "=== PHASE 2: Data-size scaling ==="
./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_20000_labeled.csv ./diabetes_output/diabetes_20000_unlabeled.csv /tmp/temp.csv 5 1
./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_20000_labeled.csv ./diabetes_output/diabetes_20000_unlabeled.csv /tmp/temp.csv 5 8
mpiexec -n 8 ./mpi_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_20000_labeled.csv ./diabetes_output/diabetes_20000_unlabeled.csv /tmp/temp.csv 5 8
mpiexec --oversubscribe -n 2 ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_20000_labeled.csv ./diabetes_output/diabetes_20000_unlabeled.csv /tmp/temp.csv 5 4

./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_100000_labeled.csv ./diabetes_output/diabetes_100000_unlabeled.csv /tmp/temp.csv 5 1
./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_100000_labeled.csv ./diabetes_output/diabetes_100000_unlabeled.csv /tmp/temp.csv 5 8
mpiexec -n 8 ./mpi_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_100000_labeled.csv ./diabetes_output/diabetes_100000_unlabeled.csv /tmp/temp.csv 5 8
mpiexec --oversubscribe -n 2 ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_100000_labeled.csv ./diabetes_output/diabetes_100000_unlabeled.csv /tmp/temp.csv 5 4

./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_500000_labeled.csv ./diabetes_output/diabetes_500000_unlabeled.csv /tmp/temp.csv 5 1
./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_500000_labeled.csv ./diabetes_output/diabetes_500000_unlabeled.csv /tmp/temp.csv 5 8
mpiexec -n 8 ./mpi_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_500000_labeled.csv ./diabetes_output/diabetes_500000_unlabeled.csv /tmp/temp.csv 5 8
mpiexec --oversubscribe -n 2 ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_500000_labeled.csv ./diabetes_output/diabetes_500000_unlabeled.csv /tmp/temp.csv 5 4

# ==============================================================
# PHASE 3 - Serial baseline (5 reps at 1M)
# ==============================================================
echo "=== PHASE 3: Serial baseline (1M) ==="
./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1
./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1
./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1
