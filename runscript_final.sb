# ==============================================================
echo "=== PHASE 5: MPI scaling (1M) ==="
mpiexec -n 1 ./mpi_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1
