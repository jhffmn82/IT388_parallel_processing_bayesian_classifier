#!/bin/bash
#SBATCH --job-name="project_output"
#SBATCH --output="project_output.%j.out"
#SBATCH --partition=compute
#SBATCH --nodes=4
#SBATCH --exclusive
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=8
#SBATCH --mem=0
#SBATCH --account=isu103
#SBATCH --export=ALL
#SBATCH -t 04:00:00

# ==============================================================
# MODULE SETUP
# ==============================================================
module load cpu/0.17.3b
module load gcc/10.2.0
module load openmpi/4.1.3

echo "=== Modules loaded ==="
module list 2>&1
echo ""

# ==============================================================
# COMPILE
# ==============================================================
echo "=== Compiling binaries ==="
gcc -O2 -Wall -fopenmp nb_classifier.c -lm -o serial_executable
gcc -O2 -Wall -fopenmp omp_nb_classifier.c -lm -o omp_executable
mpicc -O2 -Wall -Wno-unused-result mpi_nb_classifier.c -lm -o mpi_executable
mpicc -O2 -Wall -fopenmp -Wno-unused-result nb_classifier_hybrid.c -lm -o hybrid_executable

if [ ! -x serial_executable ] || [ ! -x omp_executable ] || [ ! -x mpi_executable ] || [ ! -x hybrid_executable ]; then
    echo "ERROR: One or more binaries failed to compile. Aborting."
    ls -la *executable 2>/dev/null
    exit 1
fi
echo "=== All four binaries compiled successfully ==="
ls -la *executable
echo ""

# ==============================================================
# PHASE 1 - Heart correctness check (1 run each)
# ==============================================================
echo "=== PHASE 1: Heart correctness check ==="
./serial_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_serial.csv 5 1
./omp_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_omp.csv 5 8
mpiexec -n 8 ./mpi_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_mpi.csv 5 1
export OMP_NUM_THREADS=8 && mpiexec -n 4 --bind-to none ./hybrid_executable ./heart_output/heart_meta.csv ./heart_output/heart_full_labeled.csv ./heart_output/heart_full_unlabeled.csv ./heart_output/heart_hybrid.csv 5 8

# ==============================================================
# PHASE 2 - Data-size scaling (1 run each at 20k, 100k, 500k, 1m)
# ==============================================================
echo "=== PHASE 2: Data-size scaling ==="
for size in 20000 100000 500000 1000000; do
    ./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_${size}_labeled.csv ./diabetes_output/diabetes_${size}_unlabeled.csv /tmp/temp.csv 5 1
    ./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_${size}_labeled.csv ./diabetes_output/diabetes_${size}_unlabeled.csv /tmp/temp.csv 5 8
    mpiexec -n 8 ./mpi_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_${size}_labeled.csv ./diabetes_output/diabetes_${size}_unlabeled.csv /tmp/temp.csv 5 1
    export OMP_NUM_THREADS=4 && mpiexec -n 2 --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_${size}_labeled.csv ./diabetes_output/diabetes_${size}_unlabeled.csv /tmp/temp.csv 5 4
done

# ==============================================================
# PHASE 3 - Serial baseline (5 reps at 1M)
# ==============================================================
echo "=== PHASE 3: Serial baseline (1M) ==="
for run in 1 2 3 4 5; do
    ./serial_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1
done

# ==============================================================
# PHASE 4 - OMP scaling on 1M (5 reps x 5 thread counts)
# ==============================================================
echo "=== PHASE 4: OMP scaling (1M) ==="
for threads in 1 2 4 8 16; do
    for run in 1 2 3 4 5; do
        ./omp_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 $threads
    done
done

# ==============================================================
# PHASE 5 - MPI scaling on 1M (5 reps x 5 proc counts)
# ==============================================================
echo "=== PHASE 5: MPI scaling (1M) ==="
for procs in 1 2 4 8 16; do
    for run in 1 2 3 4 5; do
        mpiexec -n $procs ./mpi_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1
    done
done

# ==============================================================
# PHASE 6 - Hybrid scaling on 1M (5 reps x 5 procs x 5 threads)
#
# threads across available cores using its own affinity mechanism.
# This gives thread scaling without touching mpiexec binding flags,
# so MPI is free to use its optimal transport (shared memory intra-
# node, InfiniBand inter-node) for Allgatherv in classify_dataset.
# ==============================================================
echo "=== PHASE 6: Hybrid scaling (1M) ==="

# p=1
export OMP_NUM_THREADS=1  && for run in 1 2 3 4 5; do mpiexec -n 1  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1;  done
export OMP_NUM_THREADS=2  && for run in 1 2 3 4 5; do mpiexec -n 1  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 2;  done
export OMP_NUM_THREADS=4  && for run in 1 2 3 4 5; do mpiexec -n 1  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 4;  done
export OMP_NUM_THREADS=8  && for run in 1 2 3 4 5; do mpiexec -n 1  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 8;  done
export OMP_NUM_THREADS=16 && for run in 1 2 3 4 5; do mpiexec -n 1  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 16; done

# p=2
export OMP_NUM_THREADS=1  && for run in 1 2 3 4 5; do mpiexec -n 2  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1;  done
export OMP_NUM_THREADS=2  && for run in 1 2 3 4 5; do mpiexec -n 2  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 2;  done
export OMP_NUM_THREADS=4  && for run in 1 2 3 4 5; do mpiexec -n 2  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 4;  done
export OMP_NUM_THREADS=8  && for run in 1 2 3 4 5; do mpiexec -n 2  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 8;  done
export OMP_NUM_THREADS=16 && for run in 1 2 3 4 5; do mpiexec -n 2  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 16; done

# p=4
export OMP_NUM_THREADS=1  && for run in 1 2 3 4 5; do mpiexec -n 4  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1;  done
export OMP_NUM_THREADS=2  && for run in 1 2 3 4 5; do mpiexec -n 4  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 2;  done
export OMP_NUM_THREADS=4  && for run in 1 2 3 4 5; do mpiexec -n 4  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 4;  done
export OMP_NUM_THREADS=8  && for run in 1 2 3 4 5; do mpiexec -n 4  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 8;  done
export OMP_NUM_THREADS=16 && for run in 1 2 3 4 5; do mpiexec -n 4  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 16; done

# p=8
export OMP_NUM_THREADS=1  && for run in 1 2 3 4 5; do mpiexec -n 8  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1;  done
export OMP_NUM_THREADS=2  && for run in 1 2 3 4 5; do mpiexec -n 8  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 2;  done
export OMP_NUM_THREADS=4  && for run in 1 2 3 4 5; do mpiexec -n 8  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 4;  done
export OMP_NUM_THREADS=8  && for run in 1 2 3 4 5; do mpiexec -n 8  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 8;  done
export OMP_NUM_THREADS=16 && for run in 1 2 3 4 5; do mpiexec -n 8  --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 16; done

# p=16
export OMP_NUM_THREADS=1  && for run in 1 2 3 4 5; do mpiexec -n 16 --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 1;  done
export OMP_NUM_THREADS=2  && for run in 1 2 3 4 5; do mpiexec -n 16 --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 2;  done
export OMP_NUM_THREADS=4  && for run in 1 2 3 4 5; do mpiexec -n 16 --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 4;  done
export OMP_NUM_THREADS=8  && for run in 1 2 3 4 5; do mpiexec -n 16 --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 8;  done
export OMP_NUM_THREADS=16 && for run in 1 2 3 4 5; do mpiexec -n 16 --bind-to none ./hybrid_executable ./diabetes_output/diabetes_meta.csv ./diabetes_output/diabetes_1000000_labeled.csv ./diabetes_output/diabetes_1000000_unlabeled.csv /tmp/temp.csv 5 16; done

echo "=== ALL PHASES COMPLETE ==="